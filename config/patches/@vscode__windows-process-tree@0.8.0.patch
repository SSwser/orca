+bool GetProcessCreationTime(ProcessInfo& process_info) {
+  HANDLE hProcess = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false,
+                                process_info.pid);
+  if (hProcess == NULL) {
+    return false;
+  }
+
+  FILETIME creationTime, exitTime, kernelTime, userTime;
+  bool success = false;
+  if (GetProcessTimes(hProcess, &creationTime, &exitTime, &kernelTime,
+                      &userTime)) {
+    ULARGE_INTEGER creationTimeValue;
+    creationTimeValue.LowPart = creationTime.dwLowDateTime;
+    creationTimeValue.HighPart = creationTime.dwHighDateTime;
+    const ULONGLONG windowsToUnixEpochTicks = 116444736000000000ULL;
+    if (creationTimeValue.QuadPart > windowsToUnixEpochTicks) {
+      process_info.creationTimeMs =
+          (creationTimeValue.QuadPart - windowsToUnixEpochTicks) / 10000ULL;
+      success = process_info.creationTimeMs > 0;
+    }
+  }
+
+  CloseHandle(hProcess);
+  return success;
+}
+
 // Per documentation, it is not recommended to add or subtract values from the FILETIME
 // structure, or to cast it to ULARGE_INTEGER as this can cause alignment faults on 64-bit Windows.
 // Copy the high and low part to a ULARGE_INTEGER and peform arithmetic on that instead.
